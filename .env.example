# Copy to .env and fill in. NEVER commit real keys. The app reads keys from env only.
# The LLM client picks a provider by whichever key is present (llm.provider: auto).

# Provider auto-detect order: anthropic -> openai -> gemini -> local. Set the one you want.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
# For a non-default model, override llm.model too, e.g. DELTA_CHAT__LLM__MODEL=gemini-2.0-flash
# Optional local model (Ollama / vLLM) — no key needed. Ollama's OpenAI-compatible endpoint:
#   LOCAL_LLM_BASE_URL=http://localhost:11434/v1   (from inside Docker use host.docker.internal)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
